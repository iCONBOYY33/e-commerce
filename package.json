{
  "name": "microservecies1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "docker:dev": "docker-compose --env-file .env.development up --build",
    "docker:prod": "docker-compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml up --build -d",
    "docker:stop": "docker-compose down",
    "start:dev": "node scripts/start-dev.js",
    "start:prod": "node scripts/start-prod.js"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "zod": "3.24.1"
    }
  }
}
